# Optional hosted vision analysis. Keep real credentials in the ignored .env file.
GEMINI_API_KEY=
HF_TOKEN=
GEMMA_MODEL=gemma-4-26b-a4b-it
GEMMA_INTERVAL_SEC=10
GEMMA_MAX_REQUESTS_PER_MINUTE=6
GEMMA_REQUEST_TIMEOUT_SEC=15
GEMMA_MAX_ATTEMPTS=2

# Telegram delivery is explicitly disabled unless set to true.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# STAI local monitoring and policy configuration.
STAI_CAMERA_ID=camera-0
STAI_INCIDENT_DB=stai_incidents.sqlite3
STAI_DASHBOARD_URL=
STAI_BLUR_VARIANCE_MIN=35
STAI_BRIGHTNESS_MIN=28
STAI_OBSTRUCTION_STD_MIN=4
STAI_FROZEN_REPEATS=8
STAI_INCIDENT_DEDUPE_SEC=120
STAI_ALERT_COOLDOWN_SEC=60

# Hugging Face hosted action classification uses the monthly Inference Providers free credit.
ANOMALY_DETECTION_ENABLED=false
ANOMALY_MODEL_PROVIDER=huggingface_inference
ANOMALY_MODEL_NAME=prithivMLmods/Human-Action-Recognition
ANOMALY_CLIP_DURATION_SECONDS=5
ANOMALY_FRAME_SAMPLING_INTERVAL_SECONDS=1
ANOMALY_MIN_PERSISTENCE_WINDOWS=2
ANOMALY_ALERT_COOLDOWN_SECONDS=60
ANOMALY_INFERENCE_TIMEOUT_SECONDS=45
